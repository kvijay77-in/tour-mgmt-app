# AWS Amplify Configuration
# All variables must use the EXPO_PUBLIC_ prefix to be accessible in the app.
# See: https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_AWS_REGION=
EXPO_PUBLIC_AWS_USER_POOL_ID=
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID=
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=

# Tour Data API (from tour-data-api deployment)
EXPO_PUBLIC_TOUR_DATA_API_BASE_URL=

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# Mock Data Mode — set to 'true' to use synthetic test data without a backend
EXPO_PUBLIC_USE_MOCK_DATA=true

# Optional: S3 Bucket for assets (if needed)
EXPO_PUBLIC_AWS_S3_BUCKET=
