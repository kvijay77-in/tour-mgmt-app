# Local runs only: copy to .env.web.<dev|prod>.local (gitignored). KEY=VALUE only; never put credentials here.
# CI (.github/workflows/deploy.yml) does not use this file: it publishes with repository variables and the backend SSM values.
# NEVER add EXPO_PUBLIC_SETUP_HMAC_KEY or any EXPO_PUBLIC_REVIEW_* variable.

# --- Infra (make web-infra) ---
# required: expected AWS account id (guard; also used by make web-publish)
WEB_AWS_ACCOUNT_ID=
WEB_AWS_REGION=ap-south-1
# default tour-mgmt-web-<env>
WEB_STACK_NAME=
# Owner tag
WEB_OWNER=
# Content-Security-Policy value
WEB_CSP=
# REPORT_ONLY | ENFORCE
WEB_CSP_MODE=REPORT_ONLY
# optional: enables publisher role
WEB_GITHUB_OIDC_PROVIDER_ARN=
# optional: e.g. repo:OWNER/REPO:ref:refs/heads/develop
WEB_GITHUB_OIDC_SUBJECT=

# --- Build (make web-publish), all optional ---
# The backend values (EXPO_PUBLIC_AWS_*, EXPO_PUBLIC_TOUR_DATA_API_BASE_URL) are read from the
# tour-data-api SSM handover (/tour-data-api/<env>/mgmt) on every publish; do not add them here.
# Region of the backend SSM parameters, default ap-south-1
CONFIG_AWS_REGION=
# default: test (dev), production (prod)
APP_VARIANT=
# default: env name
EXPO_PUBLIC_ENVIRONMENT=
EXPO_PUBLIC_LOG_LEVEL=
# EXPO_PUBLIC_USE_MOCK_DATA and EXPO_PUBLIC_QR_DEV_FORMAT are forced to false by the script.
