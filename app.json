{
  "expo": {
    "name": "tour-mgmt-app",
    "slug": "tour-mgmt-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "checkin-app",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:setup.checkin-app.example.com"
      ],
      "bundleIdentifier": "com.kvijay77.tourmgmt",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kvijay77.tourmgmt",
      "versionCode": 21,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "setup.checkin-app.example.com",
              "pathPrefix": "/setup"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is required to scan the organisation setup QR code."
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID is used to unlock your saved sign-in for offline mode."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "9ca24b5e-82b1-45d8-9a96-dd72b2579fbc"
      }
    },
    "owner": "kvijay77.in",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9ca24b5e-82b1-45d8-9a96-dd72b2579fbc"
    }
  }
}
