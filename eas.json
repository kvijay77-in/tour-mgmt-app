{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK_DATA": "true",
        "EXPO_PUBLIC_LOG_LEVEL": "DEBUG",
        "EXPO_PUBLIC_API_DEBUG_GET": "false",
        "EXPO_PUBLIC_QR_DEV_FORMAT": "true"
      }
    },
    "localpreview": {
      "distribution": "internal",
      "channel": "localpreview",
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      },
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false",
        "EXPO_PUBLIC_LOG_LEVEL": "WARN",
        "EXPO_PUBLIC_API_DEBUG_GET": "false",
        "EXPO_PUBLIC_QR_DEV_FORMAT": "true"
      }
    },
    "test": {
      "distribution": "store",
      "channel": "test",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "APP_VARIANT": "test",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false",
        "EXPO_PUBLIC_LOG_LEVEL": "WARN",
        "EXPO_PUBLIC_API_DEBUG_GET": "false",
        "EXPO_PUBLIC_QR_DEV_FORMAT": "false"
      }
    },
    "adhoc": {
      "extends": "test",
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_USE_MOCK_DATA": "false",
        "EXPO_PUBLIC_LOG_LEVEL": "WARN",
        "EXPO_PUBLIC_API_DEBUG_GET": "false",
        "EXPO_PUBLIC_QR_DEV_FORMAT": "false"
      }
    }
  },
  "submit": {
    "test": {
      "ios": {
        "ascAppId": "6822635381"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "<ASC_APP_ID_DEV>"
      },
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
