        "EXPO_PUBLIC_API_DEBUG_GET": "false",
        "EXPO_PUBLIC_AWS_REGION": "ap-south-1",
        "EXPO_PUBLIC_AWS_USER_POOL_ID": "ap-south-1_MMxOi2Qmt",
        "EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID": "31s80dcc5u1oob7shuc2s4up0a",
        "EXPO_PUBLIC_TOUR_DATA_API_BASE_URL": "https://mgyezkldn2.execute-api.ap-south-1.amazonaws.com/dev",
        "EXPO_PUBLIC_REVIEW_USERNAME": "store-reviewer@someusefulapps.com",
        "EXPO_PUBLIC_REVIEW_AWS_REGION": "ap-south-1",
        "EXPO_PUBLIC_REVIEW_AWS_USER_POOL_ID": "ap-south-1_MMxOi2Qmt",
        "EXPO_PUBLIC_REVIEW_AWS_USER_POOL_WEB_CLIENT_ID": "31s80dcc5u1oob7shuc2s4up0a",
