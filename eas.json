        "EXPO_PUBLIC_QR_DEV_FORMAT": "true"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "ios": {
        "autoIncrement": true
