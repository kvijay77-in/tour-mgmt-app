# AWS Amplify Configuration (dev-mode fallback — overridden by runtime OrgConfig when present)
# All variables must use the EXPO_PUBLIC_ prefix to be accessible in the app.
# See: https://docs.expo.dev/guides/environment-variables/
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_AWS_USER_POOL_ID=ap-south-1_MMxOi2Qmt
EXPO_PUBLIC_AWS_USER_POOL_WEB_CLIENT_ID=31s80dcc5u1oob7shuc2s4up0a
# EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=
EXPO_PUBLIC_TOUR_DATA_API_BASE_URL=https://mgyezkldn2.execute-api.ap-south-1.amazonaws.com/dev

# --- Google Play review account routing (Dev backend) ---
# When this username signs in, the app routes to the Dev Cognito pool + API below,
# keeping production data isolated from the reviewer. Leave EXPO_PUBLIC_REVIEW_USERNAME
# empty to disable review routing entirely.
EXPO_PUBLIC_REVIEW_USERNAME=google-reviewer@someusefulapps.com
EXPO_PUBLIC_REVIEW_AWS_REGION=ap-south-1
EXPO_PUBLIC_REVIEW_AWS_USER_POOL_ID=ap-south-1_MMxOi2Qmt
EXPO_PUBLIC_REVIEW_AWS_USER_POOL_WEB_CLIENT_ID=31s80dcc5u1oob7shuc2s4up0a
#EXPO_PUBLIC_REVIEW_AWS_IDENTITY_POOL_ID=
EXPO_PUBLIC_REVIEW_TOUR_DATA_API_BASE_URL=https://mgyezkldn2.execute-api.ap-south-1.amazonaws.com/dev

# Optional: S3 Bucket for assets (if needed)
#EXPO_PUBLIC_AWS_S3_BUCKET=
